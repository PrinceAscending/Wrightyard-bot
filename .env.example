# Wrightyard bot environment.
# Copy to .env.local for local development, or set these in the host dashboard.
# Never commit real values. .env and .env.* are ignored except this file.

# --- Discord application ---------------------------------------------------
# Client ID is public. The token is not.
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=1566784935342252032

# The single guild this deployment serves.
DISCORD_GUILD_ID=1566778873985892442

# The only Discord user allowed to run /admin. This is a user ID, not a role.
OWNER_ID=971329961313046578

# Gateway intents to enable in the Discord Developer Portal:
#   Server Members Intent  (auto-role on join)
#   Message Content Intent stays OFF (XP only needs message metadata)
# The bot requests Guilds, GuildMembers, and GuildMessages.

# --- Website sync ----------------------------------------------------------
# Must match NEXT_PUBLIC_SITE_URL on the website. The heartbeat is disabled
# while this is the example placeholder.
SITE_URL=https://wrightyard.vercel.app

# Shared HMAC secret. Must be the exact same value as the website's
# BOT_HEARTBEAT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BOT_HEARTBEAT_SECRET=replace-with-64-char-random

# --- Discord channels and roles -------------------------------------------
ANNOUNCEMENTS_CHANNEL_ID=1566786878416486500
TICKET_PANEL_CHANNEL_ID=1566786959937110218
TICKET_LOG_CHANNEL_ID=1566787034545262783
TICKET_CATEGORY_ID=1566786838973128829

# Staff roles can open, claim, close, and delete tickets, and see the staff
# rooms. Founder, Wright, Steward, Moderator.
STAFF_ROLE_IDS=1566787080439337103,1566787076458815621,1567499945492353064,1567499947526459486

# Applied to every new human on join. Crew is the base role.
AUTO_ROLE_IDS=1566787063687422062

# Applied to every new bot on join. TrueForce marks bots.
BOT_AUTO_ROLE_IDS=1569036599193510008

# level:roleId pairs. The highest reached role is kept and lower ladder roles
# are removed as the member climbs. Apprentice, Journeyman, Craftsman, Master.
LEVEL_ROLE_IDS=5:1567499950219329627,15:1567499952458834070,30:1567499954723881083,50:1567499957144129608

# Welcome notice and level-up notices. Empty values fall back to channels
# named #welcome and #ship-log.
WELCOME_CHANNEL_ID=1566786868530511984
LEVEL_UP_CHANNEL_ID=1567494676171202570

# Optional path for the JSON level ledger when MongoDB is not configured.
# LEVELS_FILE=

# --- Shared state ----------------------------------------------------------
# The bot writes durable ticket history and XP to MongoDB. The website reads
# ticket history for the owner's ledger and member files. Use the same values
# as the website, and never commit the real URI.
MONGODB_URI=mongodb+srv://wrightyard:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wrightyard

# --- AI --------------------------------------------------------------------
# Groq powers /ask and /brief. Create a key at https://console.groq.com/keys.
# Leave empty to disable the AI commands without stopping the rest of the bot.
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-20b

# --- Runtime ---------------------------------------------------------------
# Health server. Most hosts route their health check to this port.
PORT=8080
