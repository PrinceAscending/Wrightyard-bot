{
  "name": "wrightyard-bot",
  "version": "1.1.0",
  "private": true,
  "description": "The Wrightyard yard bot: status, stats, tickets, and a quiet heartbeat.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:bundle": "node index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:source": "tsx src/deploy-commands.ts",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node --check index.js",
    "check-version": "node scripts/check-version.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
